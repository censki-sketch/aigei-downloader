{
  "name": "aigei-downloader",
  "version": "1.0.1",
  "description": "爱给网批量下载桌面工具 - 基于 Electron + Vue 3",
  "author": "rihao",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node --require ./crypto-polyfill.js node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "node --require ./crypto-polyfill.js node_modules/electron-vite/bin/electron-vite.js build",
    "preview": "electron-vite preview",
    "build:exe": "node --require ./crypto-polyfill.js node_modules/electron-vite/bin/electron-vite.js build && electron-builder --win nsis --x64",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -SkipInstaller",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "extract-zip": "^2.0.1",
    "playwright": "^1.47.0",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@vitejs/plugin-vue": "^5.1.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vue": "^3.5.0",
    "vue-router": "^4.4.3"
  },
  "build": {
    "appId": "com.rihao.aigei-downloader",
    "productName": "AigeiDownloader",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*",
      "node_modules/playwright/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "爱给下载器",
      "uninstallDisplayName": "爱给下载器"
    }
  }
}
